# build output is never committed (generated Lua, packaged mods, logs, saves)
build/

# transpiler checkout produced by `factorio-mod bootstrap`
vendor/

# local tool caches
.cache/
.dotnet/
.local/
.nuget/
.sudo_as_admin_successful

# .NET build artifacts
bin/
obj/

# asset render cache (regenerated by `factorio-mod assets`)
mods/*/assets/.render.json

# installers write here
dist/
release/

# editor and tool scratch
.DS_Store
Thumbs.db
*.user
*.suo

# local verifier / template-engine scratch
.pluginVerifier/
.templateengine/
.tmpinstall/
